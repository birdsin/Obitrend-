{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/video-payment-verify",
      "destination": "/api/video-payment"
    },
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    }
  ],
  "headers": [
    {
      "source": "/studio/assets/pro-gate-qvV4GcOA.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/studio/assets/tools._toolId-C3AMPal4.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

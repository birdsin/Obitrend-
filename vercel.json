{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/studio/text-to-prompt",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/text-to-prompt/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/prompt-studio/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/video-payment-verify",
      "destination": "/api/video-payment"
    },
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    }
  ],
  "headers": [
    {
      "source": "/studio/assets/pro-gate-B_CRDIhM.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/studio/assets/studio-context-CBP69TUz.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/studio/assets/tools._toolId-DLkqZ1cG.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

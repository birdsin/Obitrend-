{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/generate-video-flixly.js": {
      "maxDuration": 60
    },
    "api/video-status-flixly.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/studio/text-to-prompt",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/text-to-prompt/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/prompt-studio/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/video-payment-verify",
      "destination": "/api/video-payment"
    },
    {
      "source": "/api/generate-video",
      "destination": "/api/generate-video-flixly"
    },
    {
      "source": "/api/video-status",
      "destination": "/api/video-status-flixly"
    },
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    }
  ]
}
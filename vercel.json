{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/studio/text-to-prompt",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/text-to-prompt/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    },
    {
      "source": "/studio/prompt-studio/",
      "destination": "/studio/prompt-studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    }
  ]
}
